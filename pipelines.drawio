<mxfile host="app.diagrams.net">
  <diagram id="pipelines" name="Pipelines">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="titulo" value="&lt;b&gt;Streaming de áudio RTP/UDP com GStreamer — pipelines implementadas&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="boxT" value="&lt;b&gt;Transmissor&lt;/b&gt; (transmissor.c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=center;fontSize=14;arcSize=3;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="320" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="boxR" value="&lt;b&gt;Receptor&lt;/b&gt; (receptor.c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=center;fontSize=14;arcSize=3;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="680" height="640" as="geometry"/>
        </mxCell>

        <mxCell id="T1" value="&lt;b&gt;audiotestsrc&lt;/b&gt;&lt;br&gt;wave=sine  freq=440&lt;br&gt;is-live=true&lt;br&gt;num-buffers=500 (argv[3])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;audioconvert&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;audioresample&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="T4" value="&lt;b&gt;caps (capsfilter)&lt;/b&gt;&lt;br&gt;audio/x-raw, format=S16BE&lt;br&gt;rate=44100, channels=2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="T5" value="&lt;b&gt;rtpL16pay&lt;/b&gt;&lt;br&gt;payload=96 (padrão)&lt;br&gt;1 buffer de áudio → 3 pacotes RTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="T6" value="&lt;b&gt;netsim&lt;/b&gt; (opcional — simula rede ruim)&lt;br&gt;drop-probability = perda% / 100 (argv[4])&lt;br&gt;delay-probability=0.5&lt;br&gt;max-delay = argv[5] ms (testes: 2% / 80 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="T7" value="&lt;b&gt;udpsink&lt;/b&gt;&lt;br&gt;host = argv[1] (127.0.0.1)&lt;br&gt;port = argv[2] (5000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="280" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eT1" style="endArrow=classic;html=1;" edge="1" parent="1" source="T1" target="T2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT2" style="endArrow=classic;html=1;" edge="1" parent="1" source="T2" target="T3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT3" style="endArrow=classic;html=1;" edge="1" parent="1" source="T3" target="T4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT4" style="endArrow=classic;html=1;" edge="1" parent="1" source="T4" target="T5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT5" style="endArrow=classic;html=1;" edge="1" parent="1" source="T5" target="T6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT6" style="endArrow=classic;html=1;" edge="1" parent="1" source="T6" target="T7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="R1" value="&lt;b&gt;udpsrc&lt;/b&gt;&lt;br&gt;port = argv[1] (5000)&lt;br&gt;caps = application/x-rtp, media=audio,&lt;br&gt;clock-rate=44100, encoding-name=L16,&lt;br&gt;channels=2, payload=96" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;rtpjitterbuffer&lt;/b&gt; (name=jitbuf)&lt;br&gt;latency = argv[2] ms&lt;br&gt;(testes: 20 / 200 / 1000 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;rtpL16depay&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;audioconvert&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="R5" value="&lt;b&gt;tee&lt;/b&gt; (name=t — só quando há arquivo .wav)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="R6" value="&lt;b&gt;queue → audioresample →&lt;br&gt;autoaudiosink&lt;/b&gt;&lt;br&gt;sync=false&lt;br&gt;(reproduz no alto-falante)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="R7" value="&lt;b&gt;queue → audioconvert →&lt;br&gt;wavenc → filesink&lt;/b&gt;&lt;br&gt;location = argv[4] (.wav)&lt;br&gt;(opcional — grava o áudio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="550" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="R8" value="&lt;b&gt;Diagnóstico de perdas&lt;/b&gt;&lt;br&gt;print_jitterbuffer_stats (a cada 1 s)&lt;br&gt;lê a propriedade &lt;i&gt;stats&lt;/i&gt;:&lt;br&gt;num-pushed, num-lost,&lt;br&gt;num-late, num-duplicates&lt;br&gt;→ terminal + CSV (argv[3])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="190" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="eR1" style="endArrow=classic;html=1;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR2" style="endArrow=classic;html=1;" edge="1" parent="1" source="R2" target="R3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR3" style="endArrow=classic;html=1;" edge="1" parent="1" source="R3" target="R4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR4" style="endArrow=classic;html=1;" edge="1" parent="1" source="R4" target="R5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR5" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R5" target="R6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR6" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R5" target="R7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eR7" value="consulta" style="endArrow=classic;html=1;dashed=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="R8" target="R2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eNet" value="&lt;b&gt;Rede&lt;/b&gt;&lt;br&gt;pacotes RTP sobre UDP&lt;br&gt;127.0.0.1 : 5000" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;dashed=1;strokeWidth=2;strokeColor=#9673a6;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T7" target="R1">
          <mxGeometry relative="1" as="geometry">
